{
  "manifest_version": 3,
  "name": "Kick spam collapser",
  "version": "1.2.0",
  "description": "Kick chatben emote és XD spamekből egyet hagy meg",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Spam szűrő be/ki",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*", "https://*.kick.com/*"],
      "js": ["websocketFilter.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://kick.com/*", "https://*.kick.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
